# dependencias
/node_modules
/.pnp
.pnp.*
yarn-error.log

# El gestor del proyecto es yarn (ver "packageManager" en package.json).
# Se ignora el lock de npm para que un `npm install` accidental no acabe
# conviviendo con yarn.lock y produciendo árboles distintos.
package-lock.json
pnpm-lock.yaml

# next
/.next/
/out/
next-env.d.ts

# producción
/build

# entorno
.env
.env*.local

# prisma — el cliente es código generado; lo recrea `prisma generate`, que corre
# en `postinstall` y al principio de `build`.
/src/generated

# vercel
.vercel

# typescript
*.tsbuildinfo

# sistema
.DS_Store
Thumbs.db

# material de referencia: los assets originales pesan ~49 MB.
# El modelo y los reportes sí se versionan (son la fuente del importador).
/_reference/assets/
/_reference/shots/
/_reference/snippets/
/_reference/fonts/
