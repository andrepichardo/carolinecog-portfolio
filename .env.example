# ---------------------------------------------------------------------------
# Base de datos — Neon (Postgres)
# Crear un proyecto en https://console.neon.tech y copiar la cadena "pooled".
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://usuario:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Conexión directa (sin pooler): la usan las migraciones de Prisma.
DIRECT_URL="postgresql://usuario:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# ---------------------------------------------------------------------------
# Auth.js — CMS
# Generar el secreto con:  npx auth secret
# ---------------------------------------------------------------------------
AUTH_SECRET="cambiar-por-un-secreto-largo-y-aleatorio"
AUTH_TRUST_HOST="true"

# Credenciales del usuario admin que crea el seed.
ADMIN_EMAIL="info.carolineco@gmail.com"
ADMIN_PASSWORD="cambiar-antes-de-desplegar"

# ---------------------------------------------------------------------------
# Vercel Blob — almacenamiento de imágenes subidas desde el CMS
# Vercel → proyecto → Storage → Blob → conectar. Se inyecta sola en Vercel.
# ---------------------------------------------------------------------------
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxx"

# ---------------------------------------------------------------------------
# Sitio
# Solo hace falta cuando haya dominio propio. Sin definirla, se usa el dominio
# de producción que Vercel inyecta (VERCEL_PROJECT_PRODUCTION_URL); en local
# cae a localhost.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Tipografía (opcional)
# Cuando Caroline cree su proyecto web en fonts.adobe.com, poner aquí el ID
# del kit para servir las fuentes originales en vez de los sustitutos libres.
# Ej: NEXT_PUBLIC_ADOBE_FONTS_KIT="abc1def"
# ---------------------------------------------------------------------------
NEXT_PUBLIC_ADOBE_FONTS_KIT=""
